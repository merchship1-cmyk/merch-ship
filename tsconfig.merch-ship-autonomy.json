{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "agent/**/*.ts",
    "routing/**/*.ts",
    "schemas/**/*.ts",
    "stages/**/*.ts",
    "validators/**/*.ts"
  ]
}
